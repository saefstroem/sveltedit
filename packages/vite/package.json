{
  "name": "sveltedit-vite",
  "version": "0.1.0",
  "description": "Vite dev-server middleware that writes sveltedit text edits back into .svelte source files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saefstroem/sveltedit.git",
    "directory": "packages/vite"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "svelte": "catalog:",
    "tsdown": "0.23.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
