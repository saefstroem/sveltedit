{
  "name": "sveltedit",
  "version": "0.1.0",
  "description": "A dev-mode bar for Svelte 5 sites: hover any text, press the pen, edit and style it in place, and save it back into the .svelte source.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saefstroem/sveltedit.git",
    "directory": "packages/edit"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package -i src -o dist"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "3.0.1",
    "svelte": "5.57.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
